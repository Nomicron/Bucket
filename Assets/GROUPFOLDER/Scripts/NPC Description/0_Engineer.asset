  m_Script: {fileID: 11500000, guid: 7d58c2705e8120b47be03e4d199aebc5, type: 3}
  m_Name: 0_Engineer
  m_EditorClassIdentifier: Assembly-CSharp::NPC_Description
  lines:
  - "The ship\u2019s assigned engineer who\u2019s young and slightly irritating. He has been manipulated by the CEO for years, being made to believe he\u2019s not good enough or doesn\u2019t have enough experience for a promotion or a better position with better pay. He\u2019s an arrogant smarty-pants who needs to be right all the time, but also has a hidden sweet side. On the outside he seems cold but in reality he would never harm a fly."
  information: []
