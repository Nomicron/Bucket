  m_Script: {fileID: 11500000, guid: 7d58c2705e8120b47be03e4d199aebc5, type: 3}
  m_Name: 0_CrazyNeice
  m_EditorClassIdentifier: Assembly-CSharp::NPC_Description
  lines:
  - "20 year old woman whose behaviour is unpredictable and crazy. Snuck onto the boat on her own. She believes every conspiracy she reads about in the papers and also wears bizarre clothing. Even though she is the CEO\u2019s niece, her side of the family never received any of his fortune, making them remain poor. One of her conspiracy\u2019s is that she believes the main character to be an undercover detective posing as a janitor (which happens to be true), leading to some interesting conversations. \r\n"
  information: []
