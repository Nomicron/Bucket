  m_Script: {fileID: 11500000, guid: 7d58c2705e8120b47be03e4d199aebc5, type: 3}
  m_Name: 0_Butler
  m_EditorClassIdentifier: Assembly-CSharp::NPC_Description
  lines:
  - "One of the CEO\u2019s personal butlers who\u2019s been appointed to work on the boat. His son used to work for Oval but died due to the company\u2019s negligence, causing him to take revenge on the CEO. Before his son died he had a close relationship with the CEO and they were often together. He has access to a lot of the CEO\u2019s belongings and has good intel on what kind of person the CEO was. In the game he appears super friendly and kind and helps the investigation go along."
  information: []
