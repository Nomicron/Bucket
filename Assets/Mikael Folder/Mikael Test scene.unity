  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "One of the CEO\u2019s personal butlers who\u2019s been appointed to work on the boat. His son used to work for Oval but died due to the company\u2019s negligence, causing him to take revenge on the CEO. Before his son died he had a close relationship with the CEO and they were often together. He has access to a lot of the CEO\u2019s belongings and has good intel on what kind of person the CEO was. In the game he appears super friendly and kind and helps the investigation go along. "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
