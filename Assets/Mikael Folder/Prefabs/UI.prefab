  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The ship\u2019s assigned engineer who\u2019s young and slightly irritating. He has been manipulated by the CEO for years, being made to believe he\u2019s not good enough or doesn\u2019t have enough experience for a promotion or a better position with better pay. He\u2019s an arrogant smarty-pants who needs to be right all the time, but also has a hidden sweet side. On the outside he seems cold but in reality he would never harm a fly.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
